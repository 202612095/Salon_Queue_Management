{
  "name": "salon-queue-system",
  "version": "1.0.0",
  "description": "Vibe Coding Salon Queue Management System (MSc IT Lab)",
  "scripts": {
    "dev:server": "cd server && node server.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,yellow\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "cd client && npm run build",
    "start": "cd server && node server.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
